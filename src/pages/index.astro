---
import { ArrowRight, ArrowUpRight } from "@lucide/astro";

import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import FeaturedProject from "../components/FeaturedProject.astro";
import {
  previously,
  socials,
  projects,
  siteMetadata,
} from "../utils/constants";

const featured = projects.find((item) => item.name === "Sortbilly");
---

<Layout title="Head of Engineering at Travelex">
  <!-- Hero -->
  <section class="container max-w-5xl pt-16 md:pt-24 pb-16 relative">
    <p
      class="enter enter-delay-0 font-mono text-xs uppercase tracking-[0.16em] text-accent"
    >
      {siteMetadata.title}
    </p>

    <h1
      class="enter enter-delay-80 mt-4 font-display font-extrabold text-ink"
      style="font-size: var(--text-display); line-height: 1.04; letter-spacing: -0.022em;"
    >
      Hello,<br />I&rsquo;m <span class="text-accent">Manos</span><span
        class="om-cursor text-accent"
        style="animation: om-blink 1.1s steps(1) infinite;">.</span
      >
    </h1>

    <p
      class="enter enter-delay-160 mt-7 max-w-2xl text-xl md:text-2xl leading-snug text-ink-2"
    >
      Head of Engineering at <a
        href="https://www.travelex.com/"
        target="_blank"
        rel="noreferrer"
        class="text-ink underline decoration-accent decoration-2 underline-offset-[6px] hover:text-accent transition-colors"
        >Travelex</a
      >. {siteMetadata.tagline}
    </p>

    <!-- Previously -->
    <div
      class="enter enter-delay-200 mt-6 text-base md:text-lg leading-relaxed text-ink-3"
    >
      <span
        class="font-mono text-xs uppercase tracking-[0.16em] text-ink-4 mr-1"
        >Previously</span
      >
      {
        previously.map((c, i) => (
          <>
            <a
              href={c.href}
              target="_blank"
              rel="noreferrer"
              class="text-ink-2 underline decoration-line-strong decoration-1 underline-offset-4 hover:decoration-accent hover:text-accent transition-colors"
            >
              {c.label}
            </a>
            {i < previously.length - 1 && (
              <span class="text-ink-4">&nbsp;&nbsp;&middot;&nbsp;&nbsp;</span>
            )}
          </>
        ))
      }
    </div>

    <!-- CTAs + socials -->
    <div
      class="enter enter-delay-300 mt-9 flex flex-wrap items-center gap-4"
    >
      <Button href="/projects" variant="primary">
        View projects
        <ArrowRight class="size-4" />
      </Button>

      <Button href="/blog" variant="secondary">Read the blog</Button>

      <div class="ml-auto hidden md:block">
        <ul class="flex flex-wrap gap-x-6 gap-y-2">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noreferrer"
                  class="group inline-flex items-center gap-1.5 font-mono text-sm text-ink-3 hover:text-accent transition-colors"
                >
                  <span class="text-ink-4 group-hover:text-accent transition-colors">
                    {s.label}
                  </span>
                  <span>{s.handle}</span>

                  <ArrowUpRight class="size-3 opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="enter enter-delay-340 mt-9 md:hidden">
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noreferrer"
                class="group inline-flex items-center gap-1.5 font-mono text-sm text-ink-3 hover:text-accent transition-colors"
              >
                <span class="text-ink-4 group-hover:text-accent transition-colors">
                  {s.label}
                </span>
                <span>{s.handle}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {featured && <FeaturedProject project={featured} />}
</Layout>

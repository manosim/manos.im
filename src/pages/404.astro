---
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found">
  <main
    class="flex flex-col gap-12 text-center bg-white px-6 py-24 sm:py-32 lg:px-8"
  >
    <div>
      <p class="text-base font-semibold text-accent mb-8">Page Not Found</p>

      <h1
        class="font-display mt-4 text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl"
      >
        Sorry, we couldn’t find the <br /> page you’re looking for.
      </h1>
    </div>

    <div class="mt-10 flex items-center justify-center gap-x-6">
      <Button href="/">
        <span aria-hidden="true">&larr; &nbsp;</span> Back to home
      </Button>
    </div>
  </main>
</Layout>
